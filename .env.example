# ===========================================================================
# Oficina do Smartphone — Gestão
#
# Local:     copie este arquivo para `.env` e preencha a linha abaixo.
# Produção:  cole a mesma linha na Vercel → Settings → Environment Variables.
# ===========================================================================

# --------------------------------------------------------------------------
# ÚNICA VARIÁVEL OBRIGATÓRIA
#
# Troque [YOUR-PASSWORD] pela senha do banco (a criada junto com o projeto
# no Supabase). Supabase → botão "Connect" no topo → aba "ORMs" → Prisma.
#
# Na sua máquina: use o Session pooler (porta 5432) — ele cria as tabelas.
# --------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-us-east-2.pooler.supabase.com:5432/postgres"

# Na Vercel: use o Transaction pooler (porta 6543). Mesma URL, só troca 5432
# por 6543 — o modo sessão aceita poucas conexões e o serverless estoura.
#   DATABASE_URL="postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-us-east-2.pooler.supabase.com:6543/postgres"

# ===========================================================================
# Daqui para baixo é tudo opcional — o sistema funciona sem preencher nada.
# ===========================================================================

# Chave que assina os logins. Sem definir, o sistema gera uma sozinho na
# primeira execução e guarda no banco. Trocar o valor desconecta todo mundo.
# JWT_SECRET=

# --------------------------------------------------------------------------
# Mandar cada movimentação para uma planilha do Google (opcional)
# --------------------------------------------------------------------------
GOOGLE_SHEETS_ENABLED=false
# GOOGLE_SHEETS_ID=
# GOOGLE_SHEETS_TAB=Movimentacoes
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=""
